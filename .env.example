# OKX Gateway — Environment Configuration
# Copy to .env and fill in values before running: docker compose up -d
#
# Quick start (minimal):
#   1. cp .env.example .env
#   2. Set SMTP_SENDER + SMTP_AUTH_CODE for email notifications
#   3. docker compose up -d
#   4. Open http://localhost:5000

# ── SMTP Email (163.com) ─────────────────
SMTP_SENDER=your_email@163.com
SMTP_AUTH_CODE=your_smtp_auth_code

# ── Database (auto-created by docker compose) ──
# ALL passwords below MUST be set to unique, strong values
DB_HOST=mysql
DB_PORT=3306
DB_USER=okx_trader
DB_PASSWORD=
DB_NAME=okx_gateway

# ── MySQL root password (docker internal only) ──
MYSQL_ROOT_PASSWORD=

# ── Proxy (optional, leave empty for direct access) ──
# HTTPS_PROXY=
# HTTP_PROXY=

# ── OKX API (optional override) ──
# OKX_BASE_URL=https://www.okx.com
